# Copy to backend/.env. Every provider defaults to "fake", so the whole pipeline runs offline for $0.
DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=true
PUBLIC_APP_URL=http://localhost:8020
# Where SQLite and rendered media live (Railway: a volume mounted at /data, set by the Dockerfile).
# DATA_DIR=
# Use Postgres instead of SQLite:
# DATABASE_URL=postgres://user:pass@host:5432/db
# Optional; derived from DJANGO_SECRET_KEY when empty.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# fake | openrouter
LLM_PROVIDER=fake
OPENROUTER_API_KEY=
# Any OpenAI-compatible endpoint works, e.g. Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
# Check the exact model ids on openrouter.ai/models; pick ones that support structured outputs.
LLM_CHAT_MODEL=google/gemini-2.5-flash
LLM_STORY_MODEL=anthropic/claude-sonnet-5.5

# fake | fal
IMAGE_PROVIDER=fake
VIDEO_PROVIDER=fake
TTS_PROVIDER=fake
FAL_KEY=
# Model ids change often; verify each on fal.ai/models before switching providers to fal.
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_IMAGE_REF_MODEL=fal-ai/bytedance/seedream/v4.5/edit
FAL_VIDEO_MODEL_STANDARD=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
FAL_VIDEO_MODEL_PREMIUM=fal-ai/kling-video/v3/pro/image-to-video
FAL_TTS_MODEL=fal-ai/kokoro/american-english
FAL_STT_MODEL=fal-ai/whisper

# Social OAuth (Phase 1 connect only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Off: only people with a team invitation can create an account.
SIGNUP_ENABLED=false

MAX_CONCURRENT_RENDERS_PER_ORG=2
